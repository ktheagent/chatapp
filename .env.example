RELAY_ENV=development
RELAY_PUBLIC_BASE_URL=http://localhost:8080
RELAY_API_BASE_URL=http://localhost:9000
MATRIX_HOMESERVER_URL=http://localhost:8008
DATABASE_URL=postgresql://relay:relay-dev-only@localhost:5432/relay
REDIS_URL=redis://localhost:6379/0

# Web client (apps/web) — read via import.meta.env, so these must be
# prefixed with VITE_ to be exposed to the browser bundle.
VITE_MATRIX_HOMESERVER_URL=http://localhost:8008
VITE_RELAY_IDENTITY_URL=http://localhost:9001
VITE_RELAY_MODERATION_URL=http://localhost:9002

# Backend services
IDENTITY_SERVICE_PORT=9001
MODERATION_SERVICE_PORT=9002
